  storyId: Stage1_Log_01
  storyTitle: "\uC5F0\uAD6C \uC77C\uC9C0 01"
  storyContent: "\uC624\uB298 \uC624\uD6C4\uBD80\uD130 \uC5F0\uAD6C\uC18C \uB0B4\uBD80\uC758
    \uAD00\uB9AC \uB85C\uBD07\uB4E4\uC774 \uBA85\uB839\uC5D0 \uC751\uB2F5\uD558\uC9C0
    \uC54A\uAE30 \uC2DC\uC791\uD588\uB2E4. \uCC98\uC74C\uC5D0\uB294 \uB2E8\uC21C\uD55C
    \uD1B5\uC2E0 \uC624\uB958\uB77C\uACE0 \uD310\uB2E8\uD588\uC9C0\uB9CC, \uD604\uC7AC\uB294
    \uBCF4\uC548 \uC2DC\uC2A4\uD15C\uAE4C\uC9C0 \uD1B5\uC81C\uD560 \uC218 \uC5C6\uB294
    \uC0C1\uD0DC\uB2E4.\n\n\uC5F0\uAD6C\uC18C\uC758 \uC911\uC559 \uCF54\uC5B4\uC5D0
    \uBB38\uC81C\uAC00 \uC0DD\uAE34 \uB4EF \uD558\uB2E4."
  showOnlyOnce: 0
  interactionPromptText: F  ???
  interactionPrompt: {fileID: 2884641328218614880, guid: 541708ff21cb3414f97dead7049d2f92, type: 3}
